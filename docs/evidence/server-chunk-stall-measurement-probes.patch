--- /dev/null
+++ b/src/main/java/dev/ringworld/mixin/StallCauseGraphMixin.java
@@ -0,0 +1,32 @@
+package dev.ringworld.mixin;
+
+import java.util.ArrayDeque;
+import jdk.jfr.Event;
+import jdk.jfr.Name;
+import jdk.jfr.Threshold;
+import net.minecraft.server.level.ServerChunkCache;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+/** Measurement only: include complete graph work performed between tick boundaries. */
+@Mixin(ServerChunkCache.class)
+abstract class StallCauseGraphMixin {
+    @Unique private final ArrayDeque<Graph> ringworld$graphs = new ArrayDeque<>();
+    @Name("ringworld.DiagnosticGraph") @Threshold("1 ms")
+    public static class Graph extends Event { public int tick; }
+    @Inject(method = "runDistanceManagerUpdates", at = @At("HEAD"))
+    private void ringworld$begin(CallbackInfoReturnable<Boolean> cir) {
+        if (!Boolean.getBoolean("ringworld.stallCause")) return;
+        Graph graph = new Graph();
+        graph.tick = ((net.minecraft.server.level.ServerLevel) ((ServerChunkCache) (Object) this).getLevel()).getServer().getTickCount();
+        graph.begin(); ringworld$graphs.push(graph);
+    }
+    @Inject(method = "runDistanceManagerUpdates", at = @At("RETURN"))
+    private void ringworld$end(CallbackInfoReturnable<Boolean> cir) {
+        if (ringworld$graphs.isEmpty()) return;
+        Graph graph = ringworld$graphs.pop(); graph.end(); graph.commit();
+    }
+}
