diff --git a/src/main/java/dev/ringworld/mixin/StallCauseTickMixin.java b/src/main/java/dev/ringworld/mixin/StallCauseTickMixin.java
new file mode 100644
index 0000000..e70748f
--- /dev/null
+++ b/src/main/java/dev/ringworld/mixin/StallCauseTickMixin.java
@@ -0,0 +1,32 @@
+package dev.ringworld.mixin;
+
+import java.util.function.BooleanSupplier;
+import jdk.jfr.Event;
+import jdk.jfr.Name;
+import jdk.jfr.Threshold;
+import net.minecraft.server.MinecraftServer;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+/** Temporary exact boundaries; does not change vanilla tick timing. */
+@Mixin(MinecraftServer.class)
+abstract class StallCauseTickMixin {
+    @Unique private Tick ringworld$tick;
+    @Name("ringworld.DiagnosticTick") @Threshold("0 ms")
+    public static class Tick extends Event { public int tick; }
+    @Inject(method = "tickServer", at = @At("HEAD"))
+    private void ringworld$begin(BooleanSupplier haveTime, CallbackInfo ci) {
+        if (!Boolean.getBoolean("ringworld.stallCause")) return;
+        ringworld$tick = new Tick();
+        ringworld$tick.tick = ((MinecraftServer)(Object)this).getTickCount() + 1;
+        ringworld$tick.begin();
+    }
+    @Inject(method = "tickServer", at = @At("RETURN"))
+    private void ringworld$end(BooleanSupplier haveTime, CallbackInfo ci) {
+        if (ringworld$tick == null) return;
+        ringworld$tick.end(); ringworld$tick.commit(); ringworld$tick = null;
+    }
+}
diff --git a/src/main/java/dev/ringworld/mixin/StallCauseGraphMixin.java b/src/main/java/dev/ringworld/mixin/StallCauseGraphMixin.java
