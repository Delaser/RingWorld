{
  "schemaVersion": 1,
  "id": "ringworld",
  "version": "${version}",
  "name": "RingWorld",
  "description": "Turns the Overworld into a finite, seamless cylindrical ringworld with periodic gameplay and curved rendering.",
  "authors": ["Delaser"],
  "contact": {
    "homepage": "https://andwhatnotstudio.com/ringworld/"
  },
  "custom": {
    "ringworld:compatibility_api": 1
  },
  "license": "MPL-2.0",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.ringworld.platform.fabric.FabricRingWorldMod"],
    "client": ["dev.ringworld.client.RingWorldClient"]
  },
  "mixins": [
    "ringworld.mixins.json",
    "ringworld.fabric.mixins.json",
    {"config": "ringworld.client.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
